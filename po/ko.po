msgstr "%s: 종속 사용자 ID를 만들 수 없습니다: %s\n"

#: src/useradd.c:2677
#, c-format
msgid "%s: can't create subordinate group IDs: %s\n"
msgstr "%s: 종속 그룹 ID를 만들 수 없습니다: %s\n"

#: src/useradd.c:2707 src/usermod.c:2357
#, c-format
msgid "%s: warning: the user name %s to %s SELinux user mapping failed.\n"
msgstr "%s: 경고: %s 사용자 이름을 SELinux 사용자 %s로의 매핑에 실패했습니다.\n"

#: src/useradd.c:2728
#, c-format
msgid ""
"%s: warning: the home directory %s already exists.\n"
"%s: Not copying any file from skel directory into it.\n"
msgstr ""
"%s: 경고: %s 홈 디렉터리가 이미 있습니다.\n"
"%s: skel 디렉터리에서 파일을 복사하지 않습니다.\n"

#: src/userdel.c:144
msgid ""
"  -f, --force                   force some actions that would fail otherwise\n"
"                                e.g. removal of user still logged in\n"
"                                or files, even if not owned by the user\n"
msgstr ""
"  -f, --force                   실패할 수도 있는 동작을 강제로 수행합니다\n"
"                                에: 여전히 로그인한 사용자, 사용자가\n"
"                                보유하지 않은 파일이라 해도 삭제\n"

#: src/userdel.c:149
msgid "  -r, --remove                  remove home directory and mail spool\n"
msgstr "  -r, --remove                  홈 디렉터리 및 메일링 스풀을 제거합니다\n"

#: src/userdel.c:153
msgid "  -Z, --selinux-user            remove any SELinux user mapping for the user\n"
msgstr "  -Z, --selinux-user            사용자에 대한 SELinux 사용자 매핑을 제거합니다\n"

#: src/userdel.c:311
#, c-format
msgid "%s: group %s not removed because it is not the primary group of user %s.\n"
msgstr "%1$s: %3$s 사용자의 기본 그룹이 아니어서 %2$s 그룹을 제거하지 않습니다.\n"

#: src/userdel.c:319
#, c-format
msgid "%s: group %s not removed because it has other members.\n"
msgstr "%s: %s 그룹에 기타 구성원이 있어 제거하지 않았습니다.\n"

#: src/userdel.c:336
#, c-format
msgid "%s: group %s is the primary group of another user and is not removed.\n"
msgstr "%s: %s 그룹은 다른 사용자의 주요 그룹이므로 제거하지 않습니다.\n"

#: src/userdel.c:667 src/userdel.c:673
#, c-format
msgid "%s: cannot remove entry %lu from %s\n"
msgstr "%1$s: %3$s에서 %2$lu 항목을 제거할 수 없습니다\n"

#: src/userdel.c:768
#, c-format
msgid "%s: %s mail spool (%s) not found\n"
msgstr "%s: %s 메일 스풀링 (%s) 이 없습니다\n"

#: src/userdel.c:774 src/userdel.c:790 src/userdel.c:831
#, c-format
msgid "%s: warning: can't remove %s: %s\n"
msgstr "%s: 경고: %s 제거할 수 없음: %s\n"

#: src/userdel.c:815 src/userdel.c:1080
#, c-format
msgid "%s: %s not owned by %s, not removing\n"
msgstr "%s: %s은(는) %s의 소유가 아닙니다, 제거하지 않습니다\n"

#: src/userdel.c:867
#, c-format
msgid "%s: Can't allocate memory, tcb entry for %s not removed.\n"
msgstr "%s: %s의 tcb 항목을 제거하지 않아 메모리를 할당할 수 없습니다.\n"

#: src/userdel.c:872
#, c-format
msgid "%s: Cannot drop privileges: %s\n"
msgstr "%s: 별도 권한 철회 불가: %s\n"

#: src/userdel.c:882
#, c-format
msgid "%s: Cannot remove the content of %s: %s\n"
msgstr "%s: %s의 내용을 소거할 수 없습니다: %s\n"

#: src/userdel.c:891
#, c-format
msgid "%s: Cannot remove tcb files for %s: %s\n"
msgstr "%s: %s의 tcb 파일을 제거할 수 없습니다: %s\n"

#: src/userdel.c:1075
#, c-format
msgid "%s: %s home directory (%s) not found\n"
msgstr "%s: %s 홈 디렉터리 (%s) 가 없습니다\n"

#: src/userdel.c:1106
#, c-format
msgid "%s: not removing directory %s (would remove home of user %s)\n"
msgstr ""
"%s: 디렉터리 %s은(는) 제거하지 않습니다 (사용자 %s의 홈 디렉터리를\n"
"제거하게 됩니다)\n"

#: src/userdel.c:1128
#, c-format
msgid "%s: error removing subvolume %s\n"
msgstr "%s: %s 하위 볼륨 제거에 오류가 발생했습니다\n"

#: src/userdel.c:1138
#, c-format
msgid "%s: error removing directory %s\n"
msgstr "%s: 디렉터리 %s을(를) 제거하는 데 오류가 발생했습니다\n"

#: src/userdel.c:1165 src/usermod.c:2370
#, c-format
msgid "%s: warning: the user name %s to SELinux user mapping removal failed.\n"
msgstr "%s: 경고: %s 사용자 이름의 SELinux 사용자 매핑 제거에 실패했습니다.\n"

#: src/usermod.c:427
msgid ""
"  -a, --append                  append the user to the supplemental GROUPS\n"
"                                mentioned by the -G option without removing\n"
"                                the user from other groups\n"
msgstr ""
"  -a, --append                  사용자를 다른 그룹에서 제거하지 않고 -G 옵션에 지정한\n"
"                                추가 <그룹>에 사용자를 추가합니다\n"

#: src/usermod.c:431
msgid "  -c, --comment COMMENT         new value of the GECOS field\n"
msgstr "  -c, --comment <설명>          GECOS 필드에 새 값을 설정합니다\n"

#: src/usermod.c:432
msgid "  -d, --home HOME_DIR           new home directory for the user account\n"
msgstr "  -d, --home HOME_DIR           사용자 계정에 새 홈 디렉터리를 설정합니다\n"

#: src/usermod.c:433
msgid "  -e, --expiredate EXPIRE_DATE  set account expiration date to EXPIRE_DATE\n"
msgstr "  -e, --expiredate EXPIRE_DATE  계정 유효 기일을 EXPIRE_DATE로 설정합니다\n"

#: src/usermod.c:434
msgid ""
"  -f, --inactive INACTIVE       set password inactive after expiration\n"
"                                to INACTIVE\n"
msgstr ""
"  -f, --inactive <비활성>       <비활성> 시기 이후 비밀번호를 사용하지 못하도록\n"
"                                설정합니다\n"

#: src/usermod.c:436
msgid "  -g, --gid GROUP               force use GROUP as new primary group\n"
msgstr "  -g, --gid <그룹>              <그룹>을 새 기본 그룹으로 강제 설정합니다\n"

#: src/usermod.c:437
msgid "  -G, --groups GROUPS           new list of supplementary GROUPS\n"
msgstr "  -G, --groups <그룹>           새 추가 설정 <그룹> 목록\n"

#: src/usermod.c:439
msgid "  -l, --login NEW_LOGIN         new value of the login name\n"
msgstr "  -l, --login NEW_LOGIN         새 값으로 로그인 이름을 지정합니다\n"

#: src/usermod.c:440
msgid "  -L, --lock                    lock the user account\n"
msgstr "  -L, --lock                    사용자 계정을 잠급니다\n"

#: src/usermod.c:441
msgid ""
"  -m, --move-home               move contents of the home directory to the\n"
"                                new location (use only with -d)\n"
msgstr ""
"  -m, --move-home               홈 디렉터리에 들어있는 모든 내용을 새 경로로\n"
"                                이동합니다 (-d 옵션만 함께 사용)\n"

#: src/usermod.c:443
msgid "  -o, --non-unique              allow using duplicate (non-unique) UID\n"
msgstr "  -o, --non-unique              복제 (비-고유) UID 사용을 허용합니다\n"

#: src/usermod.c:444
msgid "  -p, --password PASSWORD       use encrypted password for the new password\n"
msgstr "  -p, --password <비밀번호>     새 비밀번호 지정시 암호화한 비밀번호를 활용합니다\n"

#: src/usermod.c:446
msgid ""
"  -r, --remove                  remove the user from only the supplemental GROUPS\n"
"                                mentioned by the -G option without removing\n"
"                                the user from other groups\n"
msgstr ""
"  -r, --remove                  사용자를 다른 그룹으로부터는 제거하지 않고 -G 옵션으로\n"
"                                지정한 추가 지정 <그룹>에서 사용자를 제거합니다\n"

#: src/usermod.c:451
msgid "  -u, --uid UID                 new UID for the user account\n"
msgstr "  -u, --uid UID                 사용자 계정에 새 UID를 부여합니다\n"

#: src/usermod.c:452
msgid "  -U, --unlock                  unlock the user account\n"
msgstr "  -U, --unlock                  사용자 계정 잠금을 해제합니다\n"

#: src/usermod.c:454
msgid "  -v, --add-subuids FIRST-LAST  add range of subordinate uids\n"
msgstr "  -v, --add-subuids FIRST-LAST  종속 UID 범위를 추가합니다\n"

#: src/usermod.c:455
msgid "  -V, --del-subuids FIRST-LAST  remove range of subordinate uids\n"
msgstr "  -V, --del-subuids FIRST-LAST  종속 UID 범위를 제거합니다\n"

#: src/usermod.c:456
msgid "  -w, --add-subgids FIRST-LAST  add range of subordinate gids\n"
msgstr "  -w, --add-subgids FIRST-LAST  종속 GID 범위를 추가합니다\n"

#: src/usermod.c:457
msgid "  -W, --del-subgids FIRST-LAST  remove range of subordinate gids\n"
msgstr "  -W, --del-subgids FIRST-LAST  종속 GID의 범위를 제거합니다\n"

#: src/usermod.c:458
msgid "  -S, --add-subids              add entries to sub[ud]id based on system defaults\n"
msgstr "  -S, --add-subids              시스템 기본 설정에 따라 sub[ud]id에 항목을 추가합니다\n"

#: src/usermod.c:461
msgid "  -Z, --selinux-user SEUSER     new SELinux user mapping for the user account\n"
msgstr "  -Z, --selinux-user SEUSER     새 SELinux 사용자를 사용자 계정으로 매핑합니다\n"

#: src/usermod.c:462
msgid "      --selinux-range SERANGE   new SELinux MLS range for the user account\n"
msgstr "      --selinux-range SERANGE   사용자 계정에 새 SELinux MLS 범위를 할당합니다\n"

#: src/usermod.c:485
#, c-format
msgid ""
"%s: unlocking the user's password would result in a passwordless account.\n"
"You should set a password with usermod -p to unlock this user's password.\n"
msgstr ""
"%s: 사용자의 비밀번호 잠금을 해제하면 비밀번호 없는 계정이 됩니다. 이 사용자의\n"
"비밀번호 잠금을 풀려면 usermod -p 명령으로 비밀번호 잠금을 해제해야 합니다.\n"

#: src/usermod.c:523 src/usermod.c:609
#, c-format
msgid "%s: user '%s' already exists in %s\n"
msgstr "%s: '%s' 사용자가 이미 %s 안에 있습니다\n"

#: src/usermod.c:1110
#, c-format
msgid "%s: homedir must be an absolute path\n"
msgstr "%s: 홈 디렉터리는 절대 경로여야 합니다\n"

#: src/usermod.c:1240 src/usermod.c:1249
#, c-format
msgid "%s: invalid subordinate uid range '%s'\n"
msgstr "%s: 부적절한 하위 종속 UID 범위 '%s'\n"

#: src/usermod.c:1258 src/usermod.c:1267
#, c-format
msgid "%s: invalid subordinate gid range '%s'\n"
msgstr "%s: 부적절한 하위 종속 GID 범위 '%s'\n"

#: src/usermod.c:1365
#, c-format
msgid "%s: no options\n"
msgstr "%s: 옵션 없음\n"

#: src/usermod.c:1385
#, c-format
msgid "%s: %s and %s are mutually exclusive flags\n"
msgstr "%s: %s 와 %s 플래그를 혼용할 수 없습니다\n"

#: src/usermod.c:1392
#, c-format
msgid "%s: the -L, -p, and -U flags are exclusive\n"
msgstr "%s: -L, -p, -U 플래그는 혼용할 수 없습니다\n"

#: src/usermod.c:1464
#, c-format
msgid "%s: shadow passwords required for -e and -f\n"
msgstr "%s: -e 옵션과 -f 옵션은 섀도우 비밀번호가 필요합니다\n"

#: src/usermod.c:1480
#, c-format
msgid "%s: UID '%lu' already exists\n"
msgstr "%s: '%lu' UID가 이미 있습니다\n"

#: src/usermod.c:1489 src/usermod.c:1497
#, c-format
msgid "%s: %s does not exist, you cannot use the flags %s or %s\n"
msgstr "%s: %s이(가) 없어, %s 또는 %s 플래그를 사용할 수 없습니다\n"

#: src/usermod.c:1850
#, c-format
msgid "%s: directory %s exists\n"
msgstr "%s: %s 디렉터리가 있습니다\n"

#: src/usermod.c:1862
#, c-format
msgid "%s: The previous home directory (%s) was not a directory. It is not removed and no home directories are created.\n"
msgstr "%s: 이전 홈 디렉터리 (%s) 는 디렉터리가 아닙니다. 이전 홈 디렉터리는 제거하지 않으며 별도의 홈 디렉터리 또한 만들지 않습니다.\n"

#: src/usermod.c:1885 src/usermod.c:2428
#, c-format
msgid "%s: Failed to change ownership of the home directory"
msgstr "%s: 홈 디렉터리의 소유권 전환에 실패했습니다"

#: src/usermod.c:1900
#, c-format
msgid "%s: error: cannot move subvolume from %s to %s - different device\n"
msgstr "%s: 오류: %s에서 %s까지의 하위 볼륨을 이동할 수 없음 - 상이한 장치입니다\n"

#: src/usermod.c:1913
#, c-format
msgid "%s: warning: failed to completely remove old home directory %s"
msgstr "%s: 경고: %s 이전 홈 디렉터리의 완전한 제거에 실패했습니다"

#: src/usermod.c:1929
#, c-format
msgid "%s: cannot rename directory %s to %s\n"
msgstr "%s: %s 디렉터리 이름을 %s(으)로 바꿀 수 없습니다\n"

#: src/usermod.c:1935
#, c-format
msgid "%s: The previous home directory (%s) does not exist or is inaccessible. Move cannot be completed.\n"
msgstr "%s: 이전 홈 디렉터리 (%s) 가 없거나 접근할 수 없습니다. 이동을 끝낼 수 없습니다.\n"

#: src/usermod.c:1971 src/usermod.c:1983 src/usermod.c:1999
#, c-format
msgid "%s: failed to copy the lastlog entry of user %lu to user %lu: %s\n"
msgstr "%s: 사용자 %lu의 최근 기록 항목을 사용자 %lu에 복사하는데 실패했습니다: %s\n"

#: src/usermod.c:2007
#, c-format
msgid "%s: failed to copy the lastlog entry of user %ju to user %ju: %s\n"
msgstr "%s: failed to copy the lastlog entry of user %ju to user %ju: %s\n"

#: src/usermod.c:2035 src/usermod.c:2047 src/usermod.c:2063
#, c-format
msgid "%s: failed to copy the faillog entry of user %lu to user %lu: %s\n"
msgstr "%s: 사용자 %lu의 로그인 실패 기록 항목을 사용자 %lu에 복사하는데 실패했습니다: %s\n"

#: src/usermod.c:2071
#, c-format
msgid "%s: failed to copy the faillog entry of user %ju to user %ju: %s\n"
msgstr "%s: %ju 사용자의 faillog 항목을 %ju 사용자로 복사하기에 실패했습니다: %s\n"

#: src/usermod.c:2130
#, c-format
msgid "%s: warning: %s not owned by %s\n"
msgstr "%s: 경고: %s은(는) %s이(가) 소유하고 있지 않습니다\n"

#: src/usermod.c:2138
msgid "failed to change mailbox owner"
msgstr "메일함 소유자 바꾸기에 실패했습니다"

#: src/usermod.c:2162
msgid "failed to rename mailbox"
msgstr "메일함 이름 바꾸기에 실패했습니다"

#: src/usermod.c:2254
#, c-format
msgid "%s: unable to find new subordinate uid range: %s\n"
msgstr "%s: 새 하위 UID 범위를 찾을 수 없습니다: %s\n"

#: src/usermod.c:2262
#, c-format
msgid "%s: unable to find new subordinate gid range: %s\n"
msgstr "%s: 새 하위  GID 범위를 찾을 수 없습니다: %s\n"

#: src/usermod.c:2278
#, c-format
msgid "%s: failed to remove uid range %ju-%ju from '%s'\n"
msgstr "%1$s: '%4$s'의 %2$ju-%3$ju UID 범위값 제거에 실패했습니다\n"

#: src/usermod.c:2295
#, c-format
msgid "%s: failed to add uid range %ju-%ju to '%s'\n"
msgstr "%1$s: '%4$s'(으)로의 %2$ju-%3$ju UID 범위값 추가에 실패했습니다\n"

#: src/usermod.c:2312
#, c-format
msgid "%s: failed to remove gid range %ju-%ju from '%s'\n"
msgstr "%1$s: '%4$s'의 %2$ju-%3$ju GID 범위값 제거에 실패했습니다\n"

#: src/usermod.c:2329
#, c-format
msgid "%s: failed to add gid range %ju-%ju to '%s'\n"
msgstr "%1$s: '%4$s'(으)로의 %2$ju-%3$ju GID 범위값 추가에 실패했습니다\n"

#: src/vipw.c:54
#, c-format
msgid ""
"You have modified %s.\n"
"You may need to modify %s for consistency.\n"
"Please use the command '%s' to do so.\n"
msgstr ""
"%s을(를) 수정했습니다.\n"
"내용의 일관성이 맞으려면 %s도 바꿔야 합니다.\n"
"수정하려면 '%s' 명령을 사용하십시오.\n"

#: src/vipw.c:91
msgid "  -g, --group                   edit group database\n"
msgstr "  -g, --group                   group 데이터베이스를 편집합니다\n"

